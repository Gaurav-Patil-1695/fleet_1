# fleet_1 — copy to .env and fill in real values
# Full async SQLAlchemy DSN for the PostgreSQL database (asyncpg driver)
DATABASE_URL=
SECRET_KEY=
# Runtime environment: development | production | test — FastAPI idiom for environment name
APP_ENV=development
# TCP port the Uvicorn/FastAPI server listens on
PORT=8000
# Bind address for the Uvicorn server
HOST=0.0.0.0
# Canonical base URL of this API, used for self-referencing links and CORS validation
API_BASE_URL=http://localhost:8000
# Enable FastAPI debug mode and verbose error responses; must be false in production
DEBUG=true
# Number of Uvicorn worker processes; tune per CPU count in production
WORKERS=2
# SQLAlchemy connection pool size; increase for production load
DATABASE_POOL_SIZE=10
# Maximum connections allowed beyond DATABASE_POOL_SIZE before blocking
DATABASE_MAX_OVERFLOW=20
# Seconds to wait for a connection from the pool before raising an error
DATABASE_POOL_TIMEOUT=30
# Log all SQL statements via SQLAlchemy; set true only in development
DATABASE_ECHO=false
# Secret key used to sign and verify JWT access tokens (HS256); minimum 32 bytes entropy
JWT_SECRET_KEY=
# Algorithm used for JWT signing: HS256 | RS256
JWT_ALGORITHM=HS256
# Lifetime of an issued access token in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Lifetime of a refresh token in days before the user must re-authenticate
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Separate secret for signing refresh tokens to limit blast radius if one key leaks
JWT_REFRESH_SECRET_KEY=
# bcrypt cost factor (salt rounds) for password hashing; 12 is the recommended production minimum
BCRYPT_ROUNDS=12
# Comma-separated list of allowed client origins for CORS; the React SPA origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Allow cookies/auth headers in cross-origin requests; must align with frontend fetch mode
CORS_ALLOW_CREDENTIALS=true
# Selects the OdometerProvider implementation: mock (built-in test data) | live (real feed); no code change required to switch
TELEMATICS_MODE=mock
# Base URL of the live telematics feed endpoint; required only when TELEMATICS_MODE=live
TELEMATICS_LIVE_BASE_URL=https://telematics-provider.example.com/api/v1
# API key for the live telematics provider; required only when TELEMATICS_MODE=live
TELEMATICS_API_KEY=
# How often (seconds) the background task polls the telematics feed for new odometer readings
TELEMATICS_POLL_INTERVAL_SECONDS=300
# HTTP client timeout when calling the live telematics endpoint
TELEMATICS_REQUEST_TIMEOUT_SECONDS=10
# Rolling time window in seconds over which request counts are measured
RATE_LIMIT_WINDOW_SECONDS=60
# Maximum number of requests a single client IP may make within RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_MAX_REQUESTS=100
# Redis DSN used for API response caching (depot due-list) to meet the p95 2 s SLA under load
REDIS_URL=redis://localhost:6379/0
# Default TTL for cached responses; tune per endpoint sensitivity vs. freshness requirement
CACHE_DEFAULT_TTL_SECONDS=60
# TTL specifically for the depot due-list cache entry; kept short to reflect timely overdue status
CACHE_DUE_LIST_TTL_SECONDS=30
# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Log output format: json (structured, for log aggregators) | text (human-readable for local dev)
LOG_FORMAT=json
# email of the first administrator
ADMIN_EMAIL=admin@example.com
# password of the first administrator (set it before seeding)
ADMIN_PASSWORD=
